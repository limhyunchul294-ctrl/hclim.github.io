# Optional — enables YouTube Data API v3 search in the meal-controller UI.
# Create a key at https://console.cloud.google.com/ with YouTube Data API v3 enabled.
# Restrict by HTTP referrer (e.g. https://evkmc-as-portal.vercel.app/*).
# Paste-URL / video-ID playback works without this key (oEmbed + IFrame API).
VITE_YOUTUBE_API_KEY=
