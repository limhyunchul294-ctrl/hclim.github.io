# No YouTube Data API key required.
# Parents open YouTube in a new tab, copy the video URL, then paste it here.
# Playback uses the official YouTube IFrame Player API + oEmbed (title/thumbnail).

# Split-device pairing uses MQTT over WSS (default: EMQX public broker).
# Override only if you host your own broker:
# VITE_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
#
# Topics under nyam-controller/v1/{room}/ :
#   presence/+  role discovery
#   detect      viewer → phone (face / play state)
#   command     phone → viewer (play/pause / settings / wantPreview)
#   preview     viewer → phone JPEG thumbnails (~3 fps, only while paired + 미리보기 on)
# Preview frames are not stored elsewhere — same broker path as control.

# Optional — not required for meal-controller pairing (Realtime host may be gone):
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
